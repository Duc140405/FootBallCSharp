<Window x:Class="Football_Management_System.LichThiDau"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lich Thi Dau" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E88E5" CornerRadius="8" Margin="5">
            <DockPanel Margin="15,0">
                <TextBlock Text="LICH THI DAU"
                           Foreground="White" FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center" DockPanel.Dock="Left"/>

                <Button Content="Lam moi" Width="90" Height="30"
                        Background="#607D8B" Foreground="White"
                        DockPanel.Dock="Right" VerticalAlignment="Center"
                        Click="btnRefresh_Click"/>

                <ComboBox x:Name="cboTournament" Width="250" Height="30"
                          Margin="20,0"
                          VerticalAlignment="Center"
                          DisplayMemberPath="TournamentName"
                          SelectedValuePath="TournamentID"
                          SelectionChanged="cboTournament_SelectionChanged"/>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <Border Background="#FAFAFA" CornerRadius="8" Padding="12" Margin="0,5,5,0">
                <StackPanel>
                    <TextBlock Text="Tim kiem" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtSearch" Height="30"
                             TextChanged="txtSearch_TextChanged"/>

                    <Border Background="#E3F2FD" CornerRadius="5" Padding="8" Margin="0,15,0,0">
                        <TextBlock x:Name="txtStatus" Text="San sang..." TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Right: DataGrid -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Margin="5,5,0,0">
                <DataGrid x:Name="dgSchedule" AutoGenerateColumns="False"
                          CanUserAddRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Doi nha" Binding="{Binding HomeTeamName}" Width="*"/>
                        <DataGridTextColumn Header="Doi khach" Binding="{Binding AwayTeamName}" Width="*"/>
                        <DataGridTextColumn Header="Ngay" Binding="{Binding MatchDate, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                        <DataGridTextColumn Header="San" Binding="{Binding Stadium}" Width="*"/>
                        <DataGridTextColumn Header="Giai dau" Binding="{Binding Tournament.TournamentName}" Width="*"/>
                        <DataGridTextColumn Header="Trang thai" Binding="{Binding Status}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>