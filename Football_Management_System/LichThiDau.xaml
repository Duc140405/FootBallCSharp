<Window x:Class="Football_Management_System.LichThiDau"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lich Thi Dau" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0F1115">

    <Window.Resources>

        <!-- ===== Colors ===== -->
        <SolidColorBrush x:Key="BgBrush" Color="#0F1115"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#141821"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1B202B"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#2A3140"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E8ECF4"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#AAB3C5"/>
        <SolidColorBrush x:Key="BtnYellow" Color="#F4C542"/>
        <SolidColorBrush x:Key="BtnGray" Color="#2B3342"/>

        <!-- ===== Typography ===== -->
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>

        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#101521"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="InputComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#101521"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ===== Buttons ===== -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnLive" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource BtnGray}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style x:Key="BtnBet" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource BtnYellow}"/>
            <Setter Property="Foreground" Value="#101521"/>
        </Style>

        <Style x:Key="BtnRefresh" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#2D6CDF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- ===== Badge (tên gi?i) ===== -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="#101521"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Top Bar ===== -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="#0B0D12" BorderThickness="0,0,0,1">
            <Grid Margin="16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="L?CH THI ??U" Style="{StaticResource TitleText}"/>
                    <TextBlock Text="Giao di?n d?ng card theo phong cách dark UI"
                               Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Làm m?i" Style="{StaticResource BtnRefresh}" Width="110"
                        Click="btnRefresh_Click"/>
            </Grid>
        </Border>

        <!-- ===== Body ===== -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Left Filter Panel ===== -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="14"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="TÌM KI?M" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="txtSearch" Style="{StaticResource InputTextBox}"
                                 TextChanged="txtSearch_TextChanged"
                                 PlaceholderText="Nh?p tên ??i / sân / gi?i..." />

                        <TextBlock Text="L?C THEO GI?I ??U" Style="{StaticResource LabelText}"/>
                        <ComboBox x:Name="cboTournament" Style="{StaticResource InputComboBox}"
                                  DisplayMemberPath="TournamentName"
                                  SelectedValuePath="TournamentID"
                                  SelectionChanged="cboTournament_SelectionChanged"/>

                        <TextBlock Text="TR?NG THÁI" Style="{StaticResource LabelText}"/>
                        <Border Background="#101521" CornerRadius="10" Padding="10"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="txtStatus" Text="S?n sàng..."
                                       Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="G?I Ý" Style="{StaticResource LabelText}"/>
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"
                                   Text="• Bên ph?i hi?n th? d?ng th? (card) nh? web l?ch ??u.
• Logo dùng ImageSource binding.
• Có th? thêm nhóm theo gi?i (GroupStyle) n?u b?n mu?n."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== Right: Match Cards Grid ===== -->
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="12"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Margin="14,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="icMatches" ItemsSource="{Binding Matches}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" ItemWidth="330" ItemHeight="170"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="12"
                                        Margin="8">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Badge tên gi?i -->
                                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding TournamentName}" Foreground="{StaticResource TextSecondary}"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- N?i dung tr?n -->
                                        <Grid Grid.Row="1" Margin="0,12,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Home -->
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                <Border Width="44" Height="44" CornerRadius="22" Background="#0F1115"
                                                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                                    <Image Source="{Binding HomeLogo}" Stretch="Uniform" Margin="8"/>
                                                </Border>
                                                <TextBlock Text="{Binding HomeTeamName}" Margin="0,8,0,0"
                                                           Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"
                                                           FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- Center time -->
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="VS" Foreground="{StaticResource TextSecondary}"
                                                           FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding MatchTimeText}" Margin="0,6,0,0"
                                                           Foreground="{StaticResource TextPrimary}" FontSize="14"
                                                           FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Away -->
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                <Border Width="44" Height="44" CornerRadius="22" Background="#0F1115"
                                                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                                    <Image Source="{Binding AwayLogo}" Stretch="Uniform" Margin="8"/>
                                                </Border>
                                                <TextBlock Text="{Binding AwayTeamName}" Margin="0,8,0,0"
                                                           Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"
                                                           FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Buttons -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Tr?c ti?p" Style="{StaticResource BtnLive}" Width="92" Margin="0,0,8,0"
                                                    Command="{Binding DataContext.LiveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="??t c??c" Style="{StaticResource BtnBet}" Width="92"
                                                    Command="{Binding DataContext.BetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>

                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>