<Window x:Class="Football_Management_System.StatisticsWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Thong Ke Giai Dau" Height="750" Width="1200"
		WindowStartupLocation="CenterScreen" Background="#F3F4F6">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Header -->
		<Border Grid.Row="0" Background="#1E88E5" CornerRadius="10" Margin="10,10,10,5" Padding="15,0">
			<DockPanel>
				<TextBlock Text="THONG KE GIAI DAU"
						   Foreground="White"
						   FontSize="22"
						   FontWeight="Bold"
						   VerticalAlignment="Center"
						   DockPanel.Dock="Left"/>

				<StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
					<Button Content="Lam moi"
							Width="90" Height="30"
							Background="#607D8B" Foreground="White"
							Click="btnRefresh_Click"/>
				</StackPanel>

				<ComboBox x:Name="cboTournament"
						  Width="280" Height="30"
						  Margin="30,0,20,0"
						  VerticalAlignment="Center"
						  DisplayMemberPath="TournamentName"
						  SelectedValuePath="TournamentID"
						  SelectionChanged="cboTournament_SelectionChanged"/>
			</DockPanel>
		</Border>

		<!-- Toolbar xuat giai thuong -->
		<Border Grid.Row="1" Background="#E3F2FD" CornerRadius="8" Margin="10,0,10,5" Padding="10,6">
			<DockPanel>
				<TextBlock Text="Xuat giai thuong:" FontWeight="SemiBold" FontSize="13"
						   VerticalAlignment="Center" DockPanel.Dock="Left" Margin="5,0,15,0"/>
				<StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
					<Button Content="Xuat PDF" Width="120" Height="30"
							Margin="0,0,8,0" Padding="8,0"
							Background="#E53935" Foreground="White" FontWeight="Bold"
							Click="ExportAwardsPdf_Click"/>
					<Button Content="Xuat Excel" Width="120" Height="30"
							Margin="0,0,8,0" Padding="8,0"
							Background="#43A047" Foreground="White" FontWeight="Bold"
							Click="ExportAwardsExcel_Click"/>
					<Button Content="In giai thuong" Width="120" Height="30"
							Padding="8,0"
							Background="#FB8C00" Foreground="White" FontWeight="Bold"
							Click="PrintAwards_Click"/>
				</StackPanel>
				<TextBlock/>
			</DockPanel>
		</Border>

		<!-- Thong ke nhanh -->
		<UniformGrid Grid.Row="2" Columns="4" Margin="10,5,10,0">

			<Border Background="White" Margin="5" CornerRadius="8" Padding="15">
				<StackPanel>
					<TextBlock Text="Tổng số trận" Foreground="Gray"/>
					<TextBlock x:Name="txtTotalMatches"
                               Text="0"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#1E88E5"/>
				</StackPanel>
			</Border>

			<Border Background="White" Margin="5" CornerRadius="8" Padding="15">
				<StackPanel>
					<TextBlock Text="Tổng bàn thắng" Foreground="Gray"/>
					<TextBlock x:Name="txtTotalGoals"
                               Text="0"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#43A047"/>
				</StackPanel>
			</Border>

			<Border Background="White" Margin="5" CornerRadius="8" Padding="15">
				<StackPanel>
					<TextBlock Text="Thẻ vàng" Foreground="Gray"/>
					<TextBlock x:Name="txtTotalYellow"
                               Text="0"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#FFC107"/>
				</StackPanel>
			</Border>

			<Border Background="White" Margin="5" CornerRadius="8" Padding="15">
				<StackPanel>
					<TextBlock Text="Thẻ đỏ" Foreground="Gray"/>
					<TextBlock x:Name="txtTotalRed"
                               Text="0"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#E53935"/>
				</StackPanel>
			</Border>

		</UniformGrid>

		<!-- Top ghi ban & kien tao -->
		<Grid Grid.Row="3" Margin="10,10,10,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition/>
				<ColumnDefinition/>
			</Grid.ColumnDefinitions>

			<GroupBox Header="Top ghi bàn"
                      Grid.Column="0"
                      Margin="5"
                      FontWeight="SemiBold">

				<DataGrid x:Name="dgTopScorers"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Height="200"
                          FontWeight="Normal">

					<DataGrid.Columns>
						<DataGridTextColumn Header="Cầu thủ" Binding="{Binding PlayerName}" Width="*"/>
						<DataGridTextColumn Header="Đội" Binding="{Binding TeamName}" Width="120"/>
						<DataGridTextColumn Header="Bàn thắng" Binding="{Binding Goals}" Width="80"/>
					</DataGrid.Columns>

				</DataGrid>
			</GroupBox>

			<GroupBox Header="Top kiến tạo"
                      Grid.Column="1"
                      Margin="5"
                      FontWeight="SemiBold">

				<DataGrid x:Name="dgTopAssists"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Height="200"
                          FontWeight="Normal">

					<DataGrid.Columns>
						<DataGridTextColumn Header="Cầu thủ" Binding="{Binding PlayerName}" Width="*"/>
						<DataGridTextColumn Header="Đội" Binding="{Binding TeamName}" Width="120"/>
						<DataGridTextColumn Header="Kiến tạo" Binding="{Binding Assists}" Width="80"/>
					</DataGrid.Columns>

				</DataGrid>
			</GroupBox>
		</Grid>

		<!-- The phat & Doi hinh tieu bieu -->
		<Grid Grid.Row="4" Margin="10,10,10,10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition/>
				<ColumnDefinition/>
			</Grid.ColumnDefinitions>

			<GroupBox Header="Cầu thủ nhận nhiều thẻ nhất"
                      Grid.Column="0"
                      Margin="5"
                      FontWeight="SemiBold">

				<DataGrid x:Name="dgTopCards"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          FontWeight="Normal">

					<DataGrid.Columns>
						<DataGridTextColumn Header="Cầu thủ" Binding="{Binding PlayerName}" Width="*"/>
						<DataGridTextColumn Header="Đội" Binding="{Binding TeamName}" Width="120"/>
						<DataGridTextColumn Header="Vàng" Binding="{Binding YellowCards}" Width="60"/>
						<DataGridTextColumn Header="Đỏ" Binding="{Binding RedCards}" Width="60"/>
					</DataGrid.Columns>

				</DataGrid>
			</GroupBox>

			<GroupBox Header="Đội hình tiêu biểu (thi đấu nhiều phút nhất)"
                      Grid.Column="1"
                      Margin="5"
                      FontWeight="SemiBold">

				<DataGrid x:Name="dgBestXI"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          FontWeight="Normal">

					<DataGrid.Columns>
						<DataGridTextColumn Header="Cầu thủ" Binding="{Binding PlayerName}" Width="*"/>
						<DataGridTextColumn Header="Vị trí" Binding="{Binding Position}" Width="80"/>
						<DataGridTextColumn Header="Đội" Binding="{Binding TeamName}" Width="120"/>
						<DataGridTextColumn Header="Phút" Binding="{Binding MinutesPlayed}" Width="60"/>
					</DataGrid.Columns>

				</DataGrid>
			</GroupBox>

		</Grid>

	</Grid>
</Window>